<style>
  .root {
    width: 78;
    height: 92;
    padding-top: 5;
    padding-right: 5;
    padding-bottom: 5;
    padding-left: 5;
    gap: 3;
    flex-direction: column;
    background-color: #201735;
    border-color: #6fe3ff;
    border-width: 0.8;
    border-radius: 5;
  }
  .title { color: #ffb2c7; font-size: 7; font-weight: 800; text-align: center; }
  .status { color: #ffd58a; font-size: 3.6; font-weight: 700; text-align: center; }
  .stats { flex-direction: row; gap: 2; justify-content: space-between; }
  .stat { width: 21; padding-top: 2; padding-bottom: 2; background-color: #2b2142; border-radius: 2; text-align: center; }
  .label { color: #aaa6b4; font-size: 2.4; text-align: center; }
  .value { color: #fff9ec; font-size: 4; font-weight: 800; text-align: center; }
  .primary { width: 68; height: 17; background-color: #ff5f8a; color: #fff9ec; font-size: 5; font-weight: 800; border-radius: 3; cursor: pointer; }
  .row { flex-direction: row; gap: 3; justify-content: space-between; }
  .secondary { width: 32.5; height: 13; background-color: #3d3157; color: #fff9ec; font-size: 3.5; font-weight: 700; border-radius: 3; cursor: pointer; }
  .ability { width: 32.5; height: 16; color: #1d1630; font-size: 3.4; font-weight: 800; border-radius: 3; cursor: pointer; }
  .barricade { background-color: #6fe3ff; }
  .bomb { background-color: #ff6a3d; }
  .hint { color: #d9d5df; font-size: 2.7; text-align: center; }
</style>
<Panel class="root">
  <span class="title">HEART GUARD</span>
  <span id="StatusText" class="status">HOLD HANDS STILL - CALIBRATING</span>
  <div class="stats">
    <div class="stat"><span class="label">HEART</span><span id="HealthText" class="value">10/10</span></div>
    <div class="stat"><span class="label">ENERGY</span><span id="EnergyText" class="value">0/10</span></div>
    <div class="stat"><span class="label">WAVE</span><span id="WaveText" class="value">1/5</span></div>
  </div>
  <div class="stats">
    <div class="stat"><span class="label">SCORE</span><span id="ScoreText" class="value">0000</span></div>
    <div class="stat"><span class="label">TIME</span><span id="TimeText" class="value">15%</span></div>
    <div class="stat"><span class="label">LEFT</span><span id="EnemiesText" class="value">0</span></div>
  </div>
  <button id="Btn_Start" class="primary">START WITH HANDS</button>
  <div class="row">
    <button id="Btn_Pause" class="secondary">PAUSE</button>
    <button id="Btn_Restart" class="secondary">RESTART</button>
  </div>
  <div class="row">
    <button id="Btn_Barricade" class="ability barricade">BARRICADE - 6</button>
    <button id="Btn_Bomb" class="ability bomb">BOMB - 4</button>
  </div>
  <span id="HintText" class="hint">Poke a dust bunny. Calm hands slow the swarm.</span>
</Panel>
