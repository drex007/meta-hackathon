<style>
  .root { width: 94; height: 203; padding-top: 4; padding-right: 5; padding-bottom: 4; padding-left: 5; gap: 2.1; flex-direction: column; background-color: #efe1c6; border-color: #9c663e; border-width: 1; border-radius: 5; }
  .eyebrow { color: #72513d; font-size: 2.2; font-weight: 800; text-align: center; }
  .title { color: #2d2025; font-size: 6.2; font-weight: 800; text-align: center; }
  .status { color: #7f4638; font-size: 2.5; font-weight: 700; text-align: center; }
  .row { flex-direction: row; gap: 1.7; justify-content: space-between; }
  .swatch { width: 11; height: 10; border-radius: 5; cursor: pointer; }
  .red { background-color: #d83b3b; } .yellow { background-color: #edb83d; } .blue { background-color: #316fca; }
  .white { background-color: #f4efe4; border-color: #9f917e; border-width: 0.5; } .black { background-color: #18161b; } .green { background-color: #4c9a62; }
  .tool { width: 25; height: 9.5; background-color: #483941; color: #fff7e8; font-size: 2.7; font-weight: 800; border-radius: 2; cursor: pointer; }
  .profile { width: 25; height: 9.5; background-color: #795444; color: #fff7e8; font-size: 2.5; font-weight: 800; border-radius: 2; cursor: pointer; }
  .wide { width: 39; height: 10; background-color: #c58a53; color: #231a20; font-size: 2.45; font-weight: 800; border-radius: 2; cursor: pointer; }
  .action { width: 25; height: 10; background-color: #ded0b7; color: #2d2025; font-size: 2.6; font-weight: 800; border-radius: 2; cursor: pointer; }
  .save { background-color: #496b52; color: #fff7e8; }
  .export { background-color: #345f73; color: #fff7e8; }
  .readout { width: 82; padding-top: 1.6; padding-bottom: 1.6; padding-left: 3; padding-right: 3; background-color: #2d252e; border-radius: 2; flex-direction: row; justify-content: space-between; }
  .readoutText { color: #fff7e8; font-size: 2.3; font-weight: 700; }
  .guide { width: 82; padding-top: 2; padding-bottom: 2; padding-left: 2; padding-right: 2; background-color: #9b633d; color: #fff7e8; border-radius: 2; font-size: 2.25; font-weight: 800; text-align: center; }
  .hint { color: #5f4b42; font-size: 2.15; text-align: center; }
  .storage { color: #31583d; font-size: 2.15; font-weight: 800; text-align: center; }
</style>
<Panel class="root">
  <span class="eyebrow">IMMERSIVE OIL STUDIO</span>
  <span class="title">CANVAS ATELIER</span>
  <span id="StatusText" class="status">FRESH LINEN READY</span>
  <span id="GuideText" class="guide">STEP 1: LOAD PAINT FROM THE PALETTE</span>
  <div class="row">
    <button id="ColorRed" class="swatch red"></button><button id="ColorYellow" class="swatch yellow"></button><button id="ColorBlue" class="swatch blue"></button>
    <button id="ColorWhite" class="swatch white"></button><button id="ColorBlack" class="swatch black"></button><button id="ColorGreen" class="swatch green"></button>
  </div>
  <div class="row"><button id="Btn_Small" class="tool">FINE</button><button id="Btn_Medium" class="tool">MEDIUM</button><button id="Btn_Large" class="tool">BROAD</button></div>
  <span class="eyebrow">PICK A PAINTING BRUSH</span>
  <div class="row"><button id="Btn_Flat" class="profile">ROUND</button><button id="Btn_Filbert" class="profile">FLAT</button><button id="Btn_Fan" class="profile">FAN</button></div>
  <div class="row"><button id="Btn_Blend" class="wide">CYCLE BLEND</button><button id="Btn_Stabilize" class="wide">STABILIZE</button></div>
  <div class="row"><button id="Btn_Dry" class="wide">DRY BRUSH</button><button id="Btn_Mix" class="wide">MIX PIGMENTS</button></div>
  <div class="row"><button id="Btn_Clean" class="wide">CLEAN BRUSH</button><button id="Btn_ResetMix" class="wide">RESET MIX AREA</button></div>
  <div class="row"><button id="Btn_Height" class="action">HEIGHT</button><button id="Btn_Distance" class="action">DISTANCE</button><button id="Btn_Handedness" class="action">SWAP SIDE</button></div>
  <span id="LayoutText" class="hint">RIGHT HAND / STANDARD / STANDARD</span>
  <div class="row"><button id="Btn_Undo" class="action">UNDO</button><button id="Btn_Redo" class="action">REDO</button><button id="Btn_Clear" class="action">NEW</button></div>
  <div class="row"><button id="Btn_Save" class="wide save">SAVE PROJECT</button><button id="Btn_Export" class="wide export">EXPORT PNG</button></div>
  <div class="row"><button id="Btn_Trace" class="wide">TRACE OPACITY</button><button id="Btn_Guide" class="wide">RESTART GUIDE</button></div>
  <div class="readout"><span id="ColorText" class="readoutText">CRIMSON</span><span id="BrushText" class="readoutText">MEDIUM</span></div>
  <div class="readout"><span id="ShapeText" class="readoutText">ROUND BRUSH</span><span id="LoadText" class="readoutText">LOAD 100%</span></div>
  <div class="readout"><span id="BlendText" class="readoutText">BLENDING 78%</span><span id="TraceText" class="readoutText">NO REFERENCE</span></div>
  <span id="HistoryText" class="hint">0 STROKES / 0 UNDO / 0 REDO</span>
  <span id="StorageText" class="storage">OPENING LOCAL STORAGE</span>
  <span id="PerfText" class="hint">FRAME -- MS / 900 X 675</span>
  <span class="hint">Pinch the physical brush, load pigment on the palette, then touch the bristles to the canvas.</span>
</Panel>
